PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
KNOWLEDGE_SOURCE=local
# Optional. Turns on sign-in with a student ID (e.g. 12-34567-890). Backend only: never put it in the frontend env.
# Supabase: Project Settings > API keys > secret / service_role key. Without it, students use Continue with Google (NEU accounts).
SUPABASE_SERVICE_ROLE_KEY=
